# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=client_intake

# If running inside Docker, replace localhost with your service name (e.g. postgres)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/client_intake?schema=public

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Frontend / Auth.js ───────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=auth-secret-min-32-chars
AUTH_TRUST_HOST=true
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── AI (optional) ────────────────────────────────────────────
# When set, proposal generation uses OpenAI; otherwise mock generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
